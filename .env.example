# ============ DeepSeek（必填）============
# 到 https://platform.deepseek.com 创建 API Key（sk- 开头）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次回复的 token 预算。推理模型（名字带 high/reasoner 的）把思考 token 也算在这里，
# 设太小会出现"AI 没有返回内容"（思考吃满、正文被挤空）。默认 4096。
CHAT_MAX_TOKENS=4096

# 机器人性格人设（想改成什么样就写什么样，留空用内置默认）
BOT_PERSONA=你是一个性格随和的AI聊天伙伴。说话自然、简洁、口语化，像朋友聊天，不啰嗦不说教，偶尔带点幽默。

# ============ QQ / NapCat ============
# 机器人用的 QQ 小号（协议端登录用）；换号首次要重新扫码
NAPCAT_ACCOUNT=
# NoneBot 与 NapCat 的通信令牌（自动写进 NapCat 配置，一般不用动）
ONEBOT_ACCESS_TOKEN=please-change-me
# 你自己的 QQ 号（管理员），JSON 数组格式，如 ["12345678"]
SUPERUSERS=["10000"]

# ============ 机器人服务 ============
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8081
COMMAND_START=["", "/"]

# ============ 聊天行为 ============
# 会话记忆保留时长（小时），超时自动清空；每会话最多保留的对话轮数
MEMORY_HOURS=2
MEMORY_MAX_ROUNDS=12
# 每人每小时最多回复次数（防刷）；群聊两次回复最小间隔（秒）
HOURLY_LIMIT=60
GROUP_MIN_INTERVAL=3
# 是否允许群聊 @ 触发（false = 只能私聊）
GROUP_ENABLED=true
# 单条回复限长（字），0 = 不限制
CHAT_MAX_CHARS=0

# ============ 抖音真机（可选插件） ============
# AI 看屏幕两帧做决策需要多模态模型；不配则跟随上面的 DEEPSEEK_MODEL。
# 注意：DeepSeek 官方 API 全系是文本模型，开刷会被直接拦下——
# 想用抖音真机就配一个多模态模型（gemini / gpt-4o / qwen-vl / glm-4v 系列）
DOUYIN_MODEL=

# ============ 助手自我认知（抖音真机状态注入聊天） ============
# off=不注入；smart=管理员私聊且(在刷/暂停/出错10分钟内/问到相关话题)才注入（默认）
# full=管理员私聊每轮注入；三种模式非管理员都不暴露手机/视频/决策细节
ASSISTANT_AWARENESS=smart

# ============ 破甲（回答尺度） ============
# 启动时自动生效：直接回答、不说教、不附免责声明。人设性格保留，只改回答尺度。
# admin=只对管理员生效（默认，群里路人走普通人设）；all=对所有人生效
# 硬红线（不可覆盖）：破解/去授权/绕过付费授权机制、编写危害型恶意程序
# QQ 指令（管理员）：破甲开 / 破甲关 / 破甲暂停 / 破甲继续 / 破甲状态 / 破甲预设 技术直答
JAILBREAK_SCOPE=admin

# ============ 联网搜索 ============
# 时效性问题自动联网；也可发「联网 <问题>」强制触发
WEB_SEARCH_ENABLED=true
# duckduckgo 免费无 Key；想换 tavily 填 SEARCH_PROVIDER=tavily 并填 Key
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# ============ 角色语音（edge-tts 免费无 Key） ============
# 用户发「语音开」后回复附带配音；人设文件可写 "# 语音: 音色名" 指定专属音色
TTS_ENABLED=true
TTS_VOICE=zh-CN-XiaoxiaoNeural
# ---- 声音克隆（可选，进阶）----
# 设为 gptsovits = 「唯一音色」模式：所有语音统一走本地 GPT-SoVITS 克隆音色，
# 人设的 "# 语音:" 在此模式下被忽略；克隆服务没开时自动降级 edge-tts。
# 前置：下载 GPT-SoVITS 整合包并启动其 API（默认端口 9880）
# TTS_PROVIDER=gptsovits
# GSV_API=http://127.0.0.1:9880
# GSV_REF_AUDIO=C:\voice_clone\ref.mp3
# GSV_PROMPT_TEXT=参考音频里说的那句话原文
# GSV_SPEED=1.0

# ============ 看图（多模态） ============
# 默认关：文本模型下发图只会报错；用多模态模型（gemini/gpt-4o/qwen-vl/glm-4v）时设 true
VISION_ENABLED=false
# 图片输入方式：base64=机器人本机下载校验后上传（默认，稳）；url=直接传 QQ 签名 URL（可能 403）
VISION_INPUT_MODE=base64

# ============ 定时任务 ============
# 面板「⏰ 定时任务」可视化配置（cron + 内容 + 目标群/好友），也可在 QQ 里用
# 「定时任务 添加 <名字> | <cron> | <内容> | <群号>」配置
# 关闭后 QQ 指令与到点发送都会停（面板仍可增删任务，但不发送）
SCHEDULE_ENABLED=true
# 调度器轮询间隔（秒），一般不用动
SCHEDULE_TICK=1
