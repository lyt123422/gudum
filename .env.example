# ============ DeepSeek（必填）============
# 到 https://platform.deepseek.com 创建 API Key（sk- 开头）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 机器人性格人设（想改成什么样就写什么样，留空用内置默认）
BOT_PERSONA=你是一个性格随和的AI聊天伙伴。说话自然、简洁、口语化，像朋友聊天，不啰嗦不说教，偶尔带点幽默。

# ============ QQ / NapCat ============
# 机器人用的 QQ 小号（协议端登录用）；换号首次要重新扫码
NAPCAT_ACCOUNT=
# NoneBot 与 NapCat 的通信令牌（自动写进 NapCat 配置，一般不用动）
ONEBOT_ACCESS_TOKEN=please-change-me
# 你自己的 QQ 号（管理员），JSON 数组格式，如 ["12345678"]
SUPERUSERS=["10000"]

# ============ 机器人服务 ============
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8081
COMMAND_START=["", "/"]

# ============ 聊天行为 ============
# 会话记忆保留时长（小时），超时自动清空；每会话最多保留的对话轮数
MEMORY_HOURS=2
MEMORY_MAX_ROUNDS=12
# 每人每小时最多回复次数（防刷）；群聊两次回复最小间隔（秒）
HOURLY_LIMIT=60
GROUP_MIN_INTERVAL=3
# 是否允许群聊 @ 触发（false = 只能私聊）
GROUP_ENABLED=true
# 单条回复限长（字），0 = 不限制
CHAT_MAX_CHARS=0

# ============ 联网搜索 ============
# 时效性问题自动联网；也可发「联网 <问题>」强制触发
WEB_SEARCH_ENABLED=true
# duckduckgo 免费无 Key；想换 tavily 填 SEARCH_PROVIDER=tavily 并填 Key
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# ============ 角色语音（edge-tts 免费无 Key） ============
# 用户发「语音开」后回复附带配音；人设文件可写 "# 语音: 音色名" 指定专属音色
TTS_ENABLED=true
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ============ 看图（多模态） ============
# 默认关：文本模型下发图只会报错；用多模态模型（gemini/gpt-4o/qwen-vl/glm-4v）时设 true
VISION_ENABLED=false
# 图片输入方式：base64=机器人本机下载校验后上传（默认，稳）；url=直接传 QQ 签名 URL（可能 403）
VISION_INPUT_MODE=base64
